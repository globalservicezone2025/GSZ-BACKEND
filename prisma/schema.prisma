generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Role {
    id        String   @id @default(uuid())
    name      String
    price     Float?   @default(0)
    isDeleted Boolean  @default(false)
    createdBy String?
    updatedBy String?
    deletedBy String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    modules     Module[]
    roleModules RoleModule[]
    users       User[]
}

model Module {
    id        String   @id @default(uuid())
    name      String
    isDeleted Boolean  @default(false)
    createdBy String?
    updatedBy String?
    deletedBy String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    roles       Role[]
    roleModules RoleModule[]
}

model RoleModule {
    id        String   @id @default(uuid())
    roleId    String
    moduleId  String
    isDeleted Boolean  @default(false)
    createdBy String?
    updatedBy String?
    deletedBy String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
    module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model User {
    id                   String   @id @default(uuid())
    roleId               String?
    parentId             String?
    name                 String
    email                String
    phone                String
    address              String?
    billingAddress       String?
    country              String?
    city                 String?
    postalCode           String?
    image                String?  @default("images/user/user.png")
    password             String?  @db.Text
    otp                  Int?
    otpCount             Int?     @default(0)
    initialPaymentAmount Float?   @default(0)
    initialPaymentDue    Float?   @default(0)
    installmentTime      Float?   @default(0)
    refreshToken         String?  @db.Text
    isActive             Boolean  @default(true)
    isDeleted            Boolean  @default(false)
    createdBy            String?
    updatedBy            String?
    deletedBy            String?
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt
    designation          String?  // New field

    role     Role?  @relation(fields: [roleId], references: [id])
    parent   User?  @relation("ParentIdUserId", fields: [parentId], references: [id])
    children User[] @relation("ParentIdUserId")

    payments   Payment[]
    categories Category[]
    campaigns  Campaign[]
    suppliers  Supplier[]
    wishlist   Wishlist[]
    review     Review[]
    order      Order[]
    preorder   Preorder[]
    blog       Blog[]
    eCategories ECategory[]
    carts Cart[]
}

model Banner {
    id        String   @id @default(uuid())
    title     String
    subtitle  String
    image     String
    url       String?
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model PhotoSlider {
    id        String   @id @default(uuid())
    title     String
    subtitle  String
    image     String
    url       String?
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Payment {
    id        String    @id @default(uuid())
    userId    String
    date      DateTime? @default(now())
    amount    Float     @default(0)
    due       Float?    @default(0)
    isDeleted Boolean   @default(false)
    createdBy String?
    updatedBy String?
    deletedBy String?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ECategory {
    id        String   @id @default(uuid())
    userId    String
    name      String
    text      String?
    image     String?  @default("images/category/category.png")
    slug      String
    createdBy String?
    updatedBy String?
    deletedBy String?
    isActive  Boolean  @default(true)
    isDeleted Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())
    serial    Int      @default(0) // New field

    user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    eProducts EProduct[]
}

model Category {
    id        String   @id @default(uuid())
    userId    String
    name      String
    text      String?
    image     String?  @default("images/category/category.png")
    slug      String
    createdBy String?
    updatedBy String?
    deletedBy String?
    isActive  Boolean  @default(true)
    isDeleted Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())
    serial    Int      @default(0) // New field

    user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    campaigns      Campaign[]
    subcategory    Subcategory[]
    subsubcategory Subsubcategory[]
    pricings       Pricing[]
    faq            Faq[]
}

model Subcategory {
    id          String   @id @default(uuid())
    categoryId  String
    name        String   @unique
    description String?
    text        String?
    image       String?
    slug        String   @db.Text
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now())
    serial      Int      @default(0) // New field

    category       Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    subsubcategory Subsubcategory[]
    pricings       Pricing[]
    faq            Faq[]
}

model Subsubcategory {
    id            String   @id @default(uuid())
    categoryId    String
    subCategoryId String
    name          String   @unique
    description   String?
    text          String?
    image         String?
    slug          String   @db.Text
    isActive      Boolean  @default(true)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now())
    serial        Int      @default(0) // New field

    category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    subcategory   Subcategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
    faqs          Faq[]
    contacts      Contact[]
    pricing       Pricing[]
}

model Campaign {
    id         String    @id @default(uuid())
    userId     String
    name       String
    image      String?   @default("images/campaign/campaign.png")
    date       DateTime? @default(now())
    slug       String
    categoryId String
    eCategoryId String?
    viewCount  Int?      @default(0)
    createdBy  String?
    updatedBy  String?
    deletedBy  String?
    isActive   Boolean   @default(true)
    isDeleted  Boolean   @default(false)
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Brand {
    id        String   @id @default(uuid())
    name      String   @unique
    image     String?
    slug      String   @db.Text
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Supplier {
    id        String   @id @default(uuid())
    userId    String
    name      String
    address   String
    phone     String
    email     String?
    createdBy String?
    updatedBy String?
    deletedBy String?
    isDeleted Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model EProduct {
  id          String          @id @default(uuid())
  name        String
  description String?
  color       String[]        // Array of colors
  size        String[]        // Array of sizes
  images      String[]        // <-- Multiple images supported
  price       Float
  eCategoryId String
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  eCategory   ECategory       @relation(fields: [eCategoryId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  stocks      EProductStock[]
  eReviews    EReview[]
}




model EProductStock {
  id         String   @id @default(uuid())
  eProductId String
  color      String
  size       String
  quantity   Int      @default(0)

  eProduct   EProduct @relation(fields: [eProductId], references: [id], onDelete: Cascade)
}

model Product {
    id          String   @id @default(uuid())
    name        String
    isActive    Boolean  @default(true)
    isDeal    Boolean  @default(false)
    createdBy   String?
    updatedBy   String?
    deletedBy   String?
    mainCategory String
    tags        String[]
    image       String?
    link        String?
    description String?  @db.Text
    price       Float
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model ProductAttribute {
    id                    String   @id @default(uuid())
    productId             String
    size                  String
    costPrice             Float
    retailPrice           Float
    discountPercent       Float?   @default(0)
    discountPrice         Float?   @default(0)
    discountedRetailPrice Float
    stockAmount           Float
    isDeleted             Boolean  @default(false)
    createdBy             String?
    updatedBy             String?
    deletedBy             String?
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt

    orderItem OrderItem[]
    preorder  Preorder[]
}

model ProductImage {
    id        String   @id @default(uuid())
    productId String
    image     String?  @default("images/product/product.png")
    isDeleted Boolean  @default(false)
    createdBy String?
    updatedBy String?
    deletedBy String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Color {
  id        String   @id @default(uuid())
  name      String
  code      String   // Color code, e.g. "#FFFFFF"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discount {
  id              String   @id @default(uuid())
  fromDate        DateTime
  toDate          DateTime
  categories      String[] // Array of ECategory IDs
  products        String[] // Array of EProduct IDs
  discountPercent Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EReview {
  id          String   @id @default(uuid())
  name        String
  rating      Int
  review      String?
  productId   String
  email       String
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eProduct    EProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model EOrder {
  id             String   @id @default(uuid())
  cartId         String
  name           String?
  email          String
  phoneNumber    String
  address        String
  paymentMethod  String
  paymentType    String   // New required field: cash on delivery, bkash, visa, etc.
  paymentDone    Boolean  // New required field: payment completed or not
  status         String   @default("PENDING")
  data           Boolean  // Required field
  vat            Float    // Required field
  deliveryCharge Float    // Required field
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
    PENDING
    INPROGRESS
    DELIVERED
    REFUNDED
    CANCELED
}

model Order {
    id                     String       @id @default(uuid())
    userId                 String?
    couponId               String?
    invoiceNumber          String?      @default(nanoid(6))
    customerName           String?
    customerPhone          String?
    customerAddress        String?
    customerBillingAddress String?
    customerEmail          String?
    customerCity           String?
    customerPostalCode     String?
    totalItems             Float
    subtotalCost           Float
    subtotal               Float
    paymentMethod          String?      @default("COD")
    status                 OrderStatus? @default(PENDING)
    otp                    String?
    deliveryChargeInside   Float?
    deliveryChargeOutside  Float?
    isDeleted              Boolean      @default(false)
    createdBy              String?
    updatedBy              String?
    createdAt              DateTime     @default(now())
    updatedAt              DateTime     @updatedAt

    coupon     Coupon?     @relation(fields: [couponId], references: [id], onDelete: Cascade)
    user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
    orderItems OrderItem[]
}

model OrderItem {
    id                    String   @id @default(uuid())
    orderId               String
    productId             String
    productAttributeId    String
    name                  String
    size                  String
    costPrice             Float
    retailPrice           Float
    discountPercent       Float?   @default(0)
    discountPrice         Float?   @default(0)
    discountedRetailPrice Float
    quantity              Float
    totalCostPrice        Float
    totalPrice            Float
    isDeleted             Boolean  @default(false)
    createdBy             String?
    updatedBy             String?
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt

    order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
    productAttribute ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)
}

model Wishlist {
    id        String   @id @default(uuid())
    productId String
    userId    String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
    id        String   @id @default(uuid())
    productId String
    userId    String
    rating    Float
    comment   String?  @db.Text
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now())

    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
    id              String   @id @default(uuid())
    code            String
    name            String
    orderPriceLimit Float?
    discountAmount  Float
    isActive        Boolean  @default(true)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    order Order[]
}

model Preorder {
    id                 String   @id @default(uuid())
    productId          String
    productAttributeId String?
    userId             String
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    productAttribute ProductAttribute? @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)
    user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Newsletter {
    id        String   @id @default(uuid())
    email     String
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Contact {
    id            String   @id @default(uuid())
    firstName     String
    lastName      String
    email         String
    country       String
    phoneNumber   String
    hearFrom      String
    date          DateTime
    toDate        DateTime?
    time          DateTime
    description   String
    subSubServiceId String
    isActive      Boolean  @default(true)
    isFreeContact Boolean  @default(false)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @default(now())

    subsubcategory Subsubcategory @relation(fields: [subSubServiceId], references: [id], onDelete: Cascade)
}

model Pricing {
    id            String   @id @default(uuid())
    categoryId    String
    subCategoryId String
    subSubCategoryId String
    type          String
    price         Float
    title         String
    description   String?
    isActive      Boolean  @default(true)
    isDelete      Boolean  @default(false)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    subcategory   Subcategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
    subsubcategory   Subsubcategory @relation(fields: [subSubCategoryId], references: [id], onDelete: Cascade)
}

model Faq {
    id                String   @id @default(uuid())
    categoryId        String
    subCategoryId     String
    subSubCategoryId  String?  // New field
    question          String
    answer            String
    isActive          Boolean  @default(true)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @default(now())

    category          Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    subcategory       Subcategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
    subsubcategory    Subsubcategory? @relation(fields: [subSubCategoryId], references: [id], onDelete: Cascade) // New relation
}

model Blog {
  id                String   @id @default(uuid())
  title             String
  description       String?
  image             String?
  mainTopic         String
  tags              String[]
  authorId          String
  socialMediaLinks  Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  author            User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Cart {
  id         String      @id @default(uuid())
  userId     String?     // Optional user
  deviceMac  String?     // Optional device MAC address
  vat        Float       @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
  eOrders    EOrder[]
}

model CartItem {
  id              String    @id @default(uuid())
  cartId          String
  eProductId      String
  quantity        Int       @default(1)
  price           Float     @default(0) // added
  discountPercent Float?    @default(0) // added
  color           String?   // added
  size            String?   // added

  cart       Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  eProduct   EProduct  @relation(fields: [eProductId], references: [id], onDelete: Cascade)
}


model Career {
    id               String   @id @default(uuid())
    title            String
    position         String
    location         String?
    salary           String?
    description      String?  @db.Text
    lastDateToApply  DateTime?
    visibility       Boolean  @default(true)
    createdBy        String?
    updatedBy        String?
    deletedBy        String?
    isDeleted        Boolean  @default(false)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    applications     JobApplication[]
}

model JobApplication {
    id          String   @id @default(uuid())
    name        String
    email       String
    number      String
    description String?  @db.Text
    file        String?
    careerId    String
    createdBy   String?
    updatedBy   String?
    deletedBy   String?
    isDeleted   Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
}